# OrCom Backend Environment Configuration
# Default values are suitable for local development.

# Application port (provided automatically by Railway as PORT)
PORT=8000

# Active satellite telemetry & execution provider ('mock' or 'dhruva')
SATELLITE_PROVIDER=mock

# Database connection URL
# SQLite default: sqlite:///./orcom.db
# PostgreSQL example: postgresql://user:password@host:5432/dbname
# DATABASE_URL=sqlite:///./orcom.db

# CORS Allowed Origins (comma-separated origins for web frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CORS Allowed Origin Regex (matches Vercel deployment preview and production domains)
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$
